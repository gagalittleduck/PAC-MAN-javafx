<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="Control.MenuControl"
          prefWidth="1000" prefHeight="1000"
          style="-fx-padding: 20;
         -fx-background-color: linear-gradient(to bottom, #064efd, #04edda);">

    <left>
        <VBox xmlns="http://javafx.com/javafx"
              xmlns:fx="http://javafx.com/fxml"
              alignment="CENTER" spacing="10"
              prefHeight="100"
              prefWidth="100"
              style="-fx-padding: 20;
        -fx-background-color: transparent">
            <Button fx:id="leftButton"
                    GridPane.rowIndex="0" GridPane.columnIndex="1"
                    onAction="#leftTheme" style="-fx-background-color: transparent">
                <graphic>
                    <ImageView fx:id="left" style="-fx-background-color: transparent">
                        <image>
                            <Image url="@icons/left2_image.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

        </VBox>
    </left>
    <center>
        <VBox xmlns="http://javafx.com/javafx"
              xmlns:fx="http://javafx.com/fxml"
              alignment="CENTER" spacing="10"
              style="-fx-padding: 20;"
        fx:id="MainVBox">

            <!-- 图像视图 -->
            <ImageView fitHeight="500" fitWidth="500" preserveRatio="true" fx:id="MainImage">
                <image>
                    <!-- 加载 resources/icons/mainpage.png 图片 -->
                    <Image url="@icons/mainpage.png" />
                </image>
            </ImageView>

            <!-- 文本按钮 -->
            <Button
                    fx:id="GameStartButton"
                    onAction="#startgame"
                    prefWidth="200"
                    prefHeight="60"
                    style="-fx-background-color: #ec4b4b; -fx-font-size: 20px; -fx-padding: 10 20;">
                <graphic>
                    <ImageView   fitHeight="40" fitWidth="150" preserveRatio="true">
                        <image>
                            <!-- 假设在 resources/icons/setting.jpg -->
                            <Image url="@icons/start.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>



            <Button  fx:id="settingButton"
                    GridPane.rowIndex="0"
                    onAction="#setting"
                    prefWidth="150"
                    prefHeight="40"
                    style="-fx-background-color: white; -fx-padding: 8;">
                <graphic>
                    <ImageView fx:id="set" fitHeight="40" fitWidth="150" preserveRatio="true">
                        <image>
                            <!-- 假设在 resources/icons/setting.jpg -->
                            <Image url="@icons/settings.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="tipsButton"
                    GridPane.rowIndex="0"
                    onAction="#tips"
                    prefWidth="150"
                    prefHeight="40"
                    style="-fx-background-color: white;-fx-padding: 8;">
                <graphic>
                    <ImageView fx:id="tip" fitHeight="40" fitWidth="150" preserveRatio="true">
                        <image>
                            <!-- 假设在 resources/icons/setting.jpg -->
                            <Image url="@icons/tips.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="newmapButton"
                     GridPane.rowIndex="0"
                     onAction="#newmap"
                     prefWidth="150"
                     prefHeight="40"
                     style="-fx-background-color: white; -fx-padding: 8;">
                <graphic>
                    <ImageView fx:id="newmapImage" fitHeight="40" fitWidth="150" preserveRatio="true" style="-fx-border-color: white">
                        <image>
                            <!-- 假设在 resources/icons/setting.jpg -->
                            <Image url="@icons/design.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </center>




    <right>


        <VBox xmlns="http://javafx.com/javafx"
              xmlns:fx="http://javafx.com/fxml"
              alignment="CENTER" spacing="10"
              prefHeight="100"
              prefWidth="100"
              style="-fx-padding: 20;">

            <Button fx:id="rightButton"
                    GridPane.rowIndex="0" GridPane.columnIndex="1"
                    onAction="#rightTheme" style="-fx-background-color: transparent">
                <graphic>
                    <ImageView fx:id="right">
                        <image>
                            <Image url="@icons/right_image.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </right>


</BorderPane>
